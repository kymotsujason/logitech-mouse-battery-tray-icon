# Maintainer: kymotsujason <kymotsujason@gmail.com>
pkgname=logitech-mouse-battery
pkgver=1.0.1
pkgrel=1
pkgdesc="Logitech mouse battery in the system tray"
arch=('any')
url="https://github.com/kymotsujason/logitech-mouse-battery-tray-icon"
license=('GPL-3.0-or-later')
depends=('python' 'python-pyqt6' 'systemd')
install=logitech-mouse-battery.install
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

package() {
    cd "$pkgname-$pkgver"
    install -Dm755 packaging/logitech-mouse-battery "$pkgdir/usr/bin/logitech-mouse-battery"
    install -Dm644 -t "$pkgdir/usr/share/$pkgname" src/autostart.py src/check.py src/clearAccess.py src/dbusCalls.py src/exceptionHooks.py src/hidDescriptor.py src/hidpp.py src/icon.py src/installWatch.py src/isHidpp.py src/lowBattery.py src/mice.py src/notify.py src/panelColor.py src/receivers.py src/service.py src/serviceClient.py src/serviceState.py src/tray.py src/trayHost.py src/upower.py src/version.py src/NotoSans-Medium.ttf src/OFL.txt
    install -Dm644 packaging/logitech-mouse-battery.desktop "$pkgdir/usr/share/applications/logitech-mouse-battery.desktop"
    install -Dm644 packaging/autostart/logitech-mouse-battery.desktop "$pkgdir/etc/xdg/autostart/logitech-mouse-battery.desktop"
    install -Dm644 packaging/70-logitech-mouse-battery.rules "$pkgdir/usr/lib/udev/rules.d/70-logitech-mouse-battery.rules"
    install -Dm644 packaging/logitech-mouse-battery.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/logitech-mouse-battery.svg"
    install -Dm644 packaging/io.github.kymotsujason.LogitechMouseBattery.metainfo.xml "$pkgdir/usr/share/metainfo/io.github.kymotsujason.LogitechMouseBattery.metainfo.xml"
    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm755 packaging/afterInstall.sh "$pkgdir/usr/share/$pkgname/afterInstall.sh"
    install -Dm644 packaging/systemd/logitech-mouse-battery.service "$pkgdir/usr/lib/systemd/system/logitech-mouse-battery.service"
    install -Dm644 packaging/dbus/io.github.kymotsujason.LogitechMouseBattery.conf "$pkgdir/usr/share/dbus-1/system.d/io.github.kymotsujason.LogitechMouseBattery.conf"
    install -Dm644 packaging/dbus/io.github.kymotsujason.LogitechMouseBattery.service "$pkgdir/usr/share/dbus-1/system-services/io.github.kymotsujason.LogitechMouseBattery.service"
    install -Dm644 packaging/sysusers/logitech-mouse-battery.conf "$pkgdir/usr/lib/sysusers.d/logitech-mouse-battery.conf"
    install -Dm644 packaging/alpm/logitech-mouse-battery.hook "$pkgdir/usr/share/libalpm/hooks/logitech-mouse-battery.hook"
}
