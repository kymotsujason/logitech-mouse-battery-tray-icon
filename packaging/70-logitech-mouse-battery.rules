# lets the logged in user read and write the HID++ interface of a Logitech USB device, such as a receiver or a mouse on
# its cable, that the kernel leaves to hid-generic, when its descriptor passes the app's check, which rejects any
# keyboard, keypad, or mouse collection and the DJ reports that carry a paired keyboard's keystrokes. Any program the
# user runs can then send HID++ commands to that device and to the devices paired with it, which can change their
# settings and pairings
ACTION!="remove", SUBSYSTEM=="hidraw", KERNELS=="0003:046D:*", DRIVERS=="hid-generic", PROGRAM="/usr/bin/python3 -I -B /usr/share/logitech-mouse-battery/isHidpp.py %S%p", TAG+="uaccess"
